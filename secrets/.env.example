# Variáveis de ambiente esperadas pelo agente.
# Em produção, definidas no Coolify (Settings → Environment Variables).
# Este arquivo é apenas documentação — não commitar valores reais.

# Identidade do agente
AGENT_NAME=atendente
AGENT_EMAIL=atendente@beeads.com.br

# Bloquim MCP
BLOQUIM_TOKEN=

# Semente Platform Worker
WORKER_URL=https://worker.beeads.com.br
WORKER_TOKEN=

# Evolution API (WhatsApp)
EVOLUTION_API_URL=https://evolution.beeads.com.br
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=atendente

# GitHub (opcional)
GITHUB_TOKEN=

# Google (Workspace) — JSON da service account ou OAuth2
GOOGLE_CREDENTIALS_JSON=

# Anthropic — Claude Code lê automaticamente
ANTHROPIC_API_KEY=
