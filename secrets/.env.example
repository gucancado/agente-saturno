# Variáveis de ambiente esperadas pelo agente saturno.
# Em produção, definidas no Coolify (Settings → Environment Variables).
# Este arquivo é apenas documentação — não commitar valores reais.

# Identidade do agente
AGENT_NAME=saturno
AGENT_EMAIL=saturno@beeads.com.br

# Bloquim MCP — token DEDICADO do saturno, com membership em TODOS os workspaces auditados
BLOQUIM_TOKEN=

# Semente Platform Worker (compartilhado com mercurio; token é dedicado por agente)
WORKER_URL=https://agentes-worker.beeads.com.br
WORKER_TOKEN=

# ── Número A (intake de grupos) — Evolution/QR, READ-ONLY ──────────────────
# Server compartilhado; instância e número DEDICADOS. Consome grupos via webhook.
# NOTA: instância deployada hoje é "saturno" (sem slug) → project=null no parser.
# Roteamento grupo→projeto vem do JID do grupo (workspace-map.json), não da instância.
EVOLUTION_API_URL=https://evolution.beeads.com.br
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=saturno
# Número A dedicado do saturno (intake grupos): +55 31 9595-0748

# ── Número B (AVISOS) — WhatsApp Cloud API oficial ─────────────────────────
# Número NOVO, full API. Outbound de alertas a INDIVÍDUOS (owner/time) + comandos.
# NÃO entra em grupos (Cloud API não suporta) e NÃO pode estar registrado no app
# WhatsApp (senão Meta recusa na WABA). Provisionar no Meta Business → phone_number_id.
# Envio é via worker POST /send-cloud (token Cloud vive no worker, não aqui).
# Avisos PROATIVOS (fora da janela 24h) exigem TEMPLATE aprovado na Meta.
SATURNO_CLOUD_PHONE_NUMBER_ID=    # id Graph do nº B (ex.: 1152130677980438) — preencher após provisionar
# No worker: WHATSAPP_CLOUD_NUMBERS_JSON += "<phone_number_id>": {"agent":"saturno","project":"_"}

# Supabase base-relacional (alertas do painel: meta_alerts) — leitura direta na Fase 2
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub (opcional)
GITHUB_TOKEN=

# Google (Workspace) — JSON da service account ou OAuth2
GOOGLE_CREDENTIALS_JSON=

# Anthropic — Claude Code lê automaticamente
ANTHROPIC_API_KEY=
