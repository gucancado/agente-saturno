# Variáveis de ambiente esperadas pelo agente saturno.
# Em produção, definidas no Coolify (Settings → Environment Variables).
# Este arquivo é apenas documentação — não commitar valores reais.

# Identidade do agente
AGENT_NAME=saturno
AGENT_EMAIL=saturno@beeads.com.br

# Bloquim MCP — token DEDICADO do saturno, com membership em TODOS os workspaces auditados
BLOQUIM_TOKEN=

# Semente Platform Worker (compartilhado com mercurio; token é dedicado por agente)
WORKER_URL=https://agentes-worker.beeads.com.br
WORKER_TOKEN=

# Evolution API (WhatsApp) — server compartilhado; instância e número DEDICADOS
EVOLUTION_API_URL=https://evolution.beeads.com.br
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=saturno-<slug>   # ex.: saturno-bluma → roteia p/ agent=saturno project=bluma
# Número dedicado do saturno: +55 31 9595-0748

# Supabase base-relacional (alertas do painel: meta_alerts) — leitura direta na Fase 2
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub (opcional)
GITHUB_TOKEN=

# Google (Workspace) — JSON da service account ou OAuth2
GOOGLE_CREDENTIALS_JSON=

# Anthropic — Claude Code lê automaticamente
ANTHROPIC_API_KEY=
